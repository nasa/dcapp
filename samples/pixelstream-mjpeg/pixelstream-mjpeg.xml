<DCAPP>
    <Default>
        <Text ParentAlignX="#_align_center_" LocalAlignX="#_align_center_"/>
    </Default>

    <Window Title="PixelStream MJPEG" Width="800" Height="600" VirtualWidth="800" VirtualHeight="600">

        <Rectangle Width="800" Height="600" FillColor="0.06 0.06 0.09"/>

        <Text Y="570" Size="22" FillColor="0.9 0.9 1">PixelStream MJPEG</Text>
        <Text Y="545" Size="12" FillColor="0.5 0.5 0.6">Live video stream from Python test server</Text>

        <PixelStream
            Type="#_pixelstream_mjpeg_"
            URL="http://localhost:8090/stream"
            Timeout="5"
            X="80" Y="30"
            Width="640" Height="480"
        />

        <Rectangle X="80" Y="30" Width="640" Height="480" LineColor="0.3 0.3 0.4" LineWidth="1"/>

        <Text Y="8" Size="10" FillColor="0.4 0.4 0.5">Start server first: python3 server.py</Text>

    </Window>
</DCAPP>
