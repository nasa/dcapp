<?xml version="1.0"?>
<DCAPP>
    <Variable Type="#_variable_double_" InitialValue="0">ANGLE</Variable>

    <Window Title="Primitives" X="30" Y="30" Width="1000" Height="800">
        <Default>
            <Text Size="12" FillColor="0.84 0.87 0.9"/>
        </Default>

        <Style Name="Card">
            <Container Width="300" Height="170"/>
            <Rectangle Width="300" Height="170" FillColor="0.1 0.11 0.14"
                LineColor="0.24 0.27 0.32" LineWidth="1"/>
        </Style>
        <Style Name="Heading">
            <Text Size="14" FillColor="0.38 0.8 1"
                ParentAlignX="#_align_center_" LocalAlignX="#_align_center_"/>
        </Style>
        <Style Name="Caption">
            <Text Size="9" FillColor="0.5 0.54 0.6" LocalAlignX="#_align_center_"/>
        </Style>
        <Style Name="Specimen">
            <Text Size="18" FillColor="0.88 0.91 0.95"/>
        </Style>

        <Panel VirtualWidth="1000" VirtualHeight="800" BackgroundColor="0.045 0.05 0.065">
            <Set Variable="ANGLE" Operator="#_set_add_">1</Set>
            <If Value1="@ANGLE" Operator="#_if_gt_" Value2="360">
                <Set Variable="ANGLE" Operator="#_set_equal_">0</Set>
            </If>

            <Text X="30" Y="770" Size="24" FillColor="0.95 0.97 1">Drawing primitives</Text>
            <Text X="970" Y="774" LocalAlignX="#_align_right_" Style="Caption">geometry, images, and text</Text>

            <Container Style="Card" X="30" Y="575">
                <Rectangle Style="Card"/>
                <Text Y="146" Style="Heading">Rectangle</Text>

                <Rectangle X="30" Y="62" Width="65" Height="50" FillColor="0.82 0.32 0.3"/>
                <Text X="62" Y="28" Style="Caption">fill</Text>

                <Rectangle X="118" Y="62" Width="65" Height="50" LineColor="0.3 0.82 0.48" LineWidth="2"/>
                <Text X="150" Y="28" Style="Caption">line</Text>

                <Rectangle X="206" Y="62" Width="65" Height="50" FillColor="0.26 0.46 0.84" LineColor="0.55 0.72 1" LineWidth="2"/>
                <Text X="238" Y="28" Style="Caption">both</Text>
            </Container>

            <Container Style="Card" X="350" Y="575">
                <Rectangle Style="Card"/>
                <Text Y="146" Style="Heading">Ellipse</Text>

                <Ellipse X="65" Y="85" Radius="36" FillColor="0.88 0.56 0.2"/>
                <Text X="65" Y="28" Style="Caption">fill</Text>

                <Ellipse X="150" Y="85" Radius="36" LineColor="0.22 0.82 0.58" LineWidth="3"/>
                <Text X="150" Y="28" Style="Caption">line</Text>

                <Ellipse X="235" Y="85" Radius="36" FillColor="0.48 0.26 0.8" LineColor="0.74 0.52 1" LineWidth="2"/>
                <Text X="235" Y="28" Style="Caption">both</Text>
            </Container>

            <Container Style="Card" X="670" Y="575">
                <Rectangle Style="Card"/>
                <Text Y="146" Style="Heading">Arc</Text>

                <Arc X="80" Y="82" Radius="42" Angle="250" Rotation="35" LineColor="0.88 0.42 0.62" LineWidth="5"/>
                <Text X="80" Y="28" Style="Caption">fixed angle</Text>

                <Arc X="220" Y="82" Radius="42" Angle="@ANGLE" LineColor="0.42 0.92 0.72" LineWidth="5"/>
                <Text X="220" Y="28" Style="Caption">@ANGLE(%.0f) degrees</Text>
            </Container>

            <Container Style="Card" X="30" Y="380">
                <Rectangle Style="Card"/>
                <Text Y="146" Style="Heading">Line</Text>

                <Line LineColor="0.85 0.35 0.34" LineWidth="2">
                    <Vertex X="25" Y="55"/>
                    <Vertex X="90" Y="112"/>
                </Line>
                <Line LineColor="0.3 0.82 0.48" LineWidth="3">
                    <Vertex X="105" Y="55"/>
                    <Vertex X="135" Y="112"/>
                    <Vertex X="170" Y="64"/>
                    <Vertex X="200" Y="112"/>
                </Line>
                <Line LineColor="0.36 0.55 0.95" LineWidth="7">
                    <Vertex X="218" Y="55"/>
                    <Vertex X="275" Y="112"/>
                </Line>

                <Text X="58" Y="28" Style="Caption">two vertices</Text>
                <Text X="153" Y="28" Style="Caption">polyline</Text>
                <Text X="247" Y="28" Style="Caption">width 7</Text>
            </Container>

            <Container Style="Card" X="350" Y="380">
                <Rectangle Style="Card"/>
                <Text Y="146" Style="Heading">Polygon</Text>

                <Polygon FillColor="0.88 0.66 0.24">
                    <Vertex X="38" Y="52"/>
                    <Vertex X="102" Y="52"/>
                    <Vertex X="70" Y="115"/>
                </Polygon>

                <Polygon FillColor="0.48 0.3 0.82" LineColor="0.78 0.58 1" LineWidth="2">
                    <Vertex X="195" Y="54"/>
                    <Vertex X="246" Y="54"/>
                    <Vertex X="270" Y="90"/>
                    <Vertex X="220" Y="120"/>
                    <Vertex X="170" Y="90"/>
                </Polygon>

                <Text X="70" Y="28" Style="Caption">three vertices</Text>
                <Text X="220" Y="28" Style="Caption">fill + line</Text>
            </Container>

            <Container Style="Card" X="670" Y="380">
                <Rectangle Style="Card"/>
                <Text Y="146" Style="Heading">Image</Text>

                <Image X="65" Y="82" Width="70" Height="70"
                    LocalAlignX="#_align_center_" LocalAlignY="#_align_middle_"
                    File="../../assets/nasa.png"/>
                <Image X="165" Y="82" Width="95" Height="48"
                    LocalAlignX="#_align_center_" LocalAlignY="#_align_middle_"
                    File="../../assets/nasa.png"/>
                <Image X="255" Y="82" Width="55" Height="55" Rotation="35"
                    LocalAlignX="#_align_center_" LocalAlignY="#_align_middle_"
                    File="../../assets/nasa.png"/>

                <Text X="65" Y="28" Style="Caption">square</Text>
                <Text X="165" Y="28" Style="Caption">stretched</Text>
                <Text X="255" Y="28" Style="Caption">rotated</Text>
            </Container>

            <Container Style="Card" X="30" Y="40" Width="620" Height="310">
                <Rectangle Style="Card" Width="620" Height="310"/>
                <Text Y="286" Style="Heading">Text</Text>

                <Text X="30" Y="242" Style="Specimen">Default Bitstream Vera Sans</Text>
                <Text X="30" Y="203" Style="Specimen" Font="$dcappHome/assets/fonts/hack/Hack-Regular.ttf">Hack: 0123456789</Text>

                <Text X="30" Y="159" Style="Specimen" Bold="true">Bold</Text>
                <Text X="180" Y="159" Style="Specimen" Italic="true">Italic</Text>
                <Text X="330" Y="159" Style="Specimen" Bold="true" Italic="true">Bold italic</Text>

                <Text X="30" Y="102" Size="26" FillColor="0.04 0.05 0.07" LineColor="0.3 0.82 1">Outlined text</Text>
                <Text X="30" Y="52" FillColor="0.55 0.78 1">Variable interpolation: @ANGLE(%.1f)</Text>
                <Text X="390" Y="52" FillColor="0.68 0.72 0.78">First line\nSecond line</Text>
            </Container>

            <Container Style="Card" X="670" Y="40" Height="310">
                <Rectangle Style="Card" Height="310"/>
                <Text Y="286" Style="Heading">Stroke and alpha</Text>

                <Line LineColor="0.75 0.78 0.82" LineWidth="1">
                    <Vertex X="35" Y="235"/>
                    <Vertex X="190" Y="235"/>
                </Line>
                <Text X="210" Y="230" LocalAlignX="#_align_left_" Style="Caption">1 px</Text>

                <Line LineColor="0.75 0.78 0.82" LineWidth="3">
                    <Vertex X="35" Y="205"/>
                    <Vertex X="190" Y="205"/>
                </Line>
                <Text X="210" Y="200" LocalAlignX="#_align_left_" Style="Caption">3 px</Text>

                <Line LineColor="0.75 0.78 0.82" LineWidth="7">
                    <Vertex X="35" Y="175"/>
                    <Vertex X="190" Y="175"/>
                </Line>
                <Text X="210" Y="170" LocalAlignX="#_align_left_" Style="Caption">7 px</Text>

                <Rectangle X="30" Y="38" Width="240" Height="95" FillColor="0.42 0.44 0.48"/>
                <Rectangle X="30" Y="86" Width="120" Height="47" FillColor="0.24 0.26 0.3"/>
                <Rectangle X="150" Y="38" Width="120" Height="48" FillColor="0.24 0.26 0.3"/>

                <Ellipse X="105" Y="84" Radius="42" FillColor="1 0.2 0.2 0.72"/>
                <Ellipse X="150" Y="84" Radius="42" FillColor="0.2 1 0.4 0.52"/>
                <Ellipse X="195" Y="84" Radius="42" FillColor="0.2 0.45 1 0.36"/>
            </Container>
        </Panel>
    </Window>
</DCAPP>
