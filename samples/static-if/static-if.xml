<?xml version="1.0"?>
<DCAPP>
    <Constant Name="DEBUG_MODE">1</Constant>

    <!-- Static branches may select declarations before the display is built. -->
    <If Static="true" Value="#DEBUG_MODE" Value2="1" Operator="#_if_eq_">
        <True>
            <Variable Type="#_variable_string_" InitialValue="Development">BuildProfile</Variable>
            <Variable Type="#_variable_string_" InitialValue="verbose">TelemetryMode</Variable>
            <Variable Type="#_variable_integer_" InitialValue="30">RefreshHz</Variable>
        </True>
        <False>
            <Variable Type="#_variable_string_" InitialValue="Flight">BuildProfile</Variable>
            <Variable Type="#_variable_string_" InitialValue="essential">TelemetryMode</Variable>
            <Variable Type="#_variable_integer_" InitialValue="60">RefreshHz</Variable>
        </False>
    </If>

    <Window Title="Static Configuration" X="30" Y="30" Width="760" Height="460">
        <Default>
            <Text Size="12" FillColor="0.79 0.84 0.88 1"/>
        </Default>
        <Style Name="Label">
            <Text Size="10" FillColor="0.41 0.51 0.57 1"/>
        </Style>
        <Style Name="Value">
            <Text Size="19" FillColor="0.90 0.95 0.97 1"/>
        </Style>
        <Style Name="Card">
            <Rectangle Rounded="10" FillColor="0.055 0.068 0.080 1"
                LineColor="0.15 0.22 0.26 1" LineWidth="1"/>
        </Style>
        <Style Name="BranchBanner">
            <Rectangle X="28" Y="32" Width="620" Height="62" Rounded="7" LineWidth="1"/>
        </Style>
        <Style Name="BranchMessage">
            <Text X="48" Y="63" LocalAlignY="#_align_middle_"/>
        </Style>

        <Panel VirtualWidth="760" VirtualHeight="460" BackgroundColor="0.025 0.031 0.038 1">
            <Text X="42" Y="414" Size="27" FillColor="0.93 0.96 0.98 1">Static configuration</Text>
            <Text X="42" Y="389" Style="Label">selected while the XML is parsed</Text>

            <Container X="42" Y="154" Width="676" Height="206">
                <Rectangle Style="Card"/>
                <Text X="28" Y="166" Style="Label">BUILD PROFILE</Text>
                <Text X="28" Y="128" Style="Value">@BuildProfile</Text>
                <Text X="270" Y="166" Style="Label">TELEMETRY</Text>
                <Text X="270" Y="128" Style="Value">@TelemetryMode</Text>
                <Text X="512" Y="166" Style="Label">REFRESH RATE</Text>
                <Text X="512" Y="128" Style="Value">@RefreshHz Hz</Text>

                <If Static="true" Value="#DEBUG_MODE" Value2="1" Operator="#_if_eq_">
                    <True>
                        <Rectangle Style="BranchBanner"
                            FillColor="0.08 0.27 0.22 1" LineColor="0.17 0.54 0.41 1"/>
                        <Text Style="BranchMessage" FillColor="0.53 0.96 0.76 1">diagnostics and trace channels included</Text>
                    </True>
                    <False>
                        <Rectangle Style="BranchBanner"
                            FillColor="0.11 0.20 0.30 1" LineColor="0.22 0.43 0.63 1"/>
                        <Text Style="BranchMessage" FillColor="0.59 0.82 1 1">flight telemetry profile included</Text>
                    </False>
                </If>
            </Container>

            <Text X="42" Y="105" Style="Label">Try the alternate branch:</Text>
            <Rectangle X="42" Y="42" Width="676" Height="44" Rounded="6" FillColor="0.045 0.052 0.060 1"/>
            <Text X="62" Y="64" LocalAlignY="#_align_middle_" Size="11" FillColor="0.61 0.72 0.78 1">./bin/dcapp.sh samples/static-if/static-if.xml DEBUG_MODE=0</Text>
        </Panel>
    </Window>
</DCAPP>
