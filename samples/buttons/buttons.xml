<?xml version="1.0"?>
<DCAPP>
    <Variable Type="#_variable_integer_" InitialValue="0">ToggleState</Variable>
    <Variable Type="#_variable_integer_" InitialValue="0">MomentaryState</Variable>
    <Variable Type="#_variable_integer_" InitialValue="0">ActionState</Variable>
    <Variable Type="#_variable_integer_" InitialValue="0">MasterEnable</Variable>
    <Variable Type="#_variable_integer_" InitialValue="0">ControlledState</Variable>
    <Variable Type="#_variable_integer_" InitialValue="0">CommandState</Variable>
    <Variable Type="#_variable_integer_" InitialValue="0">StatusState</Variable>
    <Variable Type="#_variable_integer_" InitialValue="1">RadioSelect</Variable>
    <Variable Type="#_variable_integer_" InitialValue="0">PointerPresses</Variable>
    <Variable Type="#_variable_integer_" InitialValue="0">PointerReleases</Variable>

    <Window Title="Buttons and Pointer Events" X="30" Y="30" Width="920" Height="660">
        <Default>
            <Text Size="12" FillColor="0.82 0.86 0.90 1"/>
        </Default>

        <Style Name="Section">
            <Text Size="13" FillColor="0.40 0.76 0.96 1"/>
        </Style>
        <Style Name="Muted">
            <Text Size="10" FillColor="0.43 0.49 0.54 1"/>
        </Style>
        <Style Name="ButtonText">
            <Text ParentAlignX="#_align_center_" ParentAlignY="#_align_middle_"
                LocalAlignX="#_align_center_" LocalAlignY="#_align_middle_" Size="13"/>
        </Style>
        <Style Name="Card">
            <Rectangle Rounded="10" FillColor="0.055 0.065 0.078 1"
                LineColor="0.16 0.20 0.24 1" LineWidth="1"/>
        </Style>
        <Style Name="ButtonTypeExample">
            <Button Y="40" Width="210" Height="50"/>
        </Style>
        <Style Name="FeedbackButton">
            <Button Y="38" Height="48"/>
        </Style>
        <Style Name="SelectionButton">
            <Button Y="24" Width="104" Height="42"/>
        </Style>
        <Style Name="ButtonOn">
            <Rectangle Rounded="6" FillColor="0.08 0.43 0.28 1"
                LineColor="0.20 0.72 0.45 1" LineWidth="1"/>
        </Style>
        <Style Name="ButtonOff">
            <Rectangle Rounded="6" FillColor="0.13 0.16 0.19 1"
                LineColor="0.28 0.34 0.38 1" LineWidth="1"/>
        </Style>

        <Panel VirtualWidth="920" VirtualHeight="660" BackgroundColor="0.025 0.030 0.037 1">
            <Text X="42" Y="612" Size="28" FillColor="0.93 0.96 0.98 1">Controls</Text>
            <Text X="42" Y="587" Style="Muted">button state machines and raw pointer events</Text>

            <Text X="42" Y="544" Style="Section">BUTTON TYPES</Text>
            <Container X="42" Y="386" Width="836" Height="138">
                <Rectangle Style="Card"/>

                <Text X="34" Y="108">Toggle</Text>
                <Button Style="ButtonTypeExample" Type="#_button_toggle_" X="34"
                    Variable="ToggleState" On="1" Off="0">
                    <ButtonIndicatorOn>
                        <Rectangle Style="ButtonOn"/>
                        <Text Style="ButtonText">ONLINE</Text>
                    </ButtonIndicatorOn>
                    <ButtonIndicatorOff>
                        <Rectangle Style="ButtonOff"/>
                        <Text Style="ButtonText">OFFLINE</Text>
                    </ButtonIndicatorOff>
                </Button>

                <Text X="313" Y="108">Momentary</Text>
                <Button Style="ButtonTypeExample" Type="#_button_momentary_" X="313"
                    Variable="MomentaryState" On="1" Off="0">
                    <ButtonIndicatorOn>
                        <Rectangle Rounded="6" FillColor="0.62 0.22 0.12 1"
                            LineColor="0.92 0.42 0.24 1" LineWidth="1"/>
                        <Text Style="ButtonText">HELD</Text>
                    </ButtonIndicatorOn>
                    <ButtonIndicatorOff>
                        <Rectangle Style="ButtonOff"/>
                        <Text Style="ButtonText">HOLD</Text>
                    </ButtonIndicatorOff>
                </Button>

                <Text X="592" Y="108">Standard action</Text>
                <Button Style="ButtonTypeExample" Type="#_button_standard_" X="592"
                    Variable="ActionState" On="7" Off="0">
                    <ButtonIndicatorOn>
                        <Rectangle Rounded="6" FillColor="0.16 0.38 0.60 1"
                            LineColor="0.28 0.58 0.84 1" LineWidth="1"/>
                        <Text Style="ButtonText">COMMAND 7</Text>
                    </ButtonIndicatorOn>
                    <ButtonIndicatorOff>
                        <Rectangle Style="ButtonOff"/>
                        <Text Style="ButtonText">SEND COMMAND</Text>
                    </ButtonIndicatorOff>
                </Button>
            </Container>

            <Text X="42" Y="350" Style="Section">ENABLE AND FEEDBACK</Text>
            <Container X="42" Y="194" Width="404" Height="136">
                <Rectangle Style="Card"/>
                <Text X="24" Y="108">Interlock</Text>
                <Text X="380" Y="108" LocalAlignX="#_align_right_" Style="Muted">controlled output @ControlledState</Text>

                <Button Style="FeedbackButton" Type="#_button_toggle_" X="24" Width="142"
                    Variable="MasterEnable" On="1" Off="0">
                    <ButtonIndicatorOn>
                        <Rectangle Style="ButtonOn"/>
                        <Text Style="ButtonText">ARMED</Text>
                    </ButtonIndicatorOn>
                    <ButtonIndicatorOff>
                        <Rectangle Style="ButtonOff"/>
                        <Text Style="ButtonText">SAFE</Text>
                    </ButtonIndicatorOff>
                </Button>

                <Button Style="FeedbackButton" Type="#_button_toggle_" X="190" Width="190"
                    Variable="ControlledState" On="1" Off="0"
                    EnableVariable="MasterEnable" EnableOn="1">
                    <ButtonIndicatorOn>
                        <Rectangle Style="ButtonOn"/>
                        <Text Style="ButtonText">OUTPUT ON</Text>
                    </ButtonIndicatorOn>
                    <ButtonIndicatorOff>
                        <Rectangle Style="ButtonOff"/>
                        <Text Style="ButtonText">OUTPUT OFF</Text>
                    </ButtonIndicatorOff>
                    <ButtonDisabled>
                        <Rectangle Rounded="6" FillColor="0.08 0.09 0.10 1"
                            LineColor="0.16 0.18 0.20 1" LineWidth="1"/>
                        <Text Style="ButtonText" FillColor="0.32 0.35 0.37 1">LOCKED</Text>
                    </ButtonDisabled>
                </Button>
            </Container>

            <Container X="474" Y="194" Width="404" Height="136">
                <Rectangle Style="Card"/>
                <Text X="24" Y="108">Command / indication</Text>
                <Text X="380" Y="108" LocalAlignX="#_align_right_" Style="Muted">cmd @CommandState  status @StatusState</Text>

                <Button Style="FeedbackButton" Type="#_button_toggle_" X="24" Width="218"
                    TargetVariable="CommandState" TargetOn="1" TargetOff="0"
                    IndicatorVariable="StatusState" IndicatorOn="1">
                    <ButtonIndicatorOn>
                        <Rectangle Style="ButtonOn"/>
                        <Text Style="ButtonText">CONFIRMED ON</Text>
                    </ButtonIndicatorOn>
                    <ButtonIndicatorOff>
                        <Rectangle Style="ButtonOff"/>
                        <Text Style="ButtonText">CONFIRMED OFF</Text>
                    </ButtonIndicatorOff>
                    <ButtonTransition>
                        <Rectangle Rounded="6" FillColor="0.56 0.38 0.08 1"
                            LineColor="0.90 0.64 0.16 1" LineWidth="1"/>
                        <Text Style="ButtonText">AWAITING STATUS</Text>
                    </ButtonTransition>
                </Button>

                <Rectangle X="262" Y="38" Width="118" Height="48" Rounded="6"
                    FillColor="0.14 0.22 0.27 1" LineColor="0.27 0.43 0.50 1" LineWidth="1">
                    <Text Style="ButtonText">ACKNOWLEDGE</Text>
                    <MousePressed><Set Variable="StatusState">@CommandState</Set></MousePressed>
                </Rectangle>
            </Container>

            <Text X="42" Y="158" Style="Section">SELECTION AND CUSTOM TARGET</Text>
            <Container X="42" Y="28" Width="404" Height="110">
                <Rectangle Style="Card"/>
                <Text X="24" Y="82">Channel @RadioSelect</Text>
                <Button Style="SelectionButton" Type="#_button_toggle_" X="24"
                    Variable="RadioSelect" On="1" Off="1">
                    <ButtonIndicatorOn><Rectangle Style="ButtonOn"/><Text Style="ButtonText">ONE</Text></ButtonIndicatorOn>
                    <ButtonIndicatorOff><Rectangle Style="ButtonOff"/><Text Style="ButtonText">ONE</Text></ButtonIndicatorOff>
                </Button>
                <Button Style="SelectionButton" Type="#_button_toggle_" X="150"
                    Variable="RadioSelect" On="2" Off="2">
                    <ButtonIndicatorOn><Rectangle Style="ButtonOn"/><Text Style="ButtonText">TWO</Text></ButtonIndicatorOn>
                    <ButtonIndicatorOff><Rectangle Style="ButtonOff"/><Text Style="ButtonText">TWO</Text></ButtonIndicatorOff>
                </Button>
                <Button Style="SelectionButton" Type="#_button_toggle_" X="276"
                    Variable="RadioSelect" On="3" Off="3">
                    <ButtonIndicatorOn><Rectangle Style="ButtonOn"/><Text Style="ButtonText">THREE</Text></ButtonIndicatorOn>
                    <ButtonIndicatorOff><Rectangle Style="ButtonOff"/><Text Style="ButtonText">THREE</Text></ButtonIndicatorOff>
                </Button>
            </Container>

            <Container X="474" Y="28" Width="404" Height="110">
                <Rectangle Style="Card"/>
                <Text X="24" Y="82">Raw pointer target</Text>
                <Text X="380" Y="82" LocalAlignX="#_align_right_" Style="Muted">press @PointerPresses  release @PointerReleases</Text>

                <Rectangle X="24" Y="24" Width="356" Height="42" Rounded="6"
                    FillColor="0.12 0.16 0.19 1" LineColor="0.25 0.31 0.35 1" LineWidth="1">
                    <Text Style="ButtonText" FillColor="0.54 0.62 0.67 1">MOVE, PRESS, AND RELEASE</Text>
                    <MouseHovered>
                        <Rectangle Rounded="6" FillColor="0 0 0 0" LineColor="0.27 0.72 0.90 1" LineWidth="2"/>
                        <Text Style="ButtonText" FillColor="0.56 0.88 1 1">HOVER</Text>
                    </MouseHovered>
                    <MouseActive>
                        <Rectangle Rounded="6" FillColor="0.10 0.36 0.43 1"/>
                        <Text Style="ButtonText">HELD</Text>
                    </MouseActive>
                    <MousePressed><Set Variable="PointerPresses" Operator="#_set_add_">1</Set></MousePressed>
                    <MouseReleased><Set Variable="PointerReleases" Operator="#_set_add_">1</Set></MouseReleased>
                </Rectangle>
            </Container>
        </Panel>
    </Window>
</DCAPP>
