<?xml version="1.0"?>
<DCAPP>
    <Window Title="Included Components" X="30" Y="30" Width="900" Height="600">
        <Constant Name="Background">0.045 0.055 0.047</Constant>
        <Constant Name="Surface">0.085 0.1 0.086</Constant>
        <Constant Name="Inset">0.058 0.07 0.06</Constant>
        <Constant Name="Border">0.21 0.27 0.21</Constant>
        <Constant Name="Leaf">0.43 0.76 0.38</Constant>
        <Constant Name="Sun">0.95 0.65 0.24</Constant>
        <Constant Name="Water">0.32 0.67 0.82</Constant>
        <Constant Name="TextStrong">0.92 0.91 0.84</Constant>
        <Constant Name="TextMuted">0.56 0.6 0.53</Constant>

        <Default>
            <Text Size="12" FillColor="#TextStrong"/>
        </Default>

        <Style Name="Card">
            <Rectangle FillColor="#Surface" LineColor="#Border" LineWidth="1"/>
        </Style>
        <Style Name="Title">
            <Text Size="24" FillColor="#TextStrong"/>
        </Style>
        <Style Name="Label">
            <Text Size="10" FillColor="#TextMuted"/>
        </Style>
        <Style Name="Readout">
            <Text Size="19" FillColor="#TextStrong"/>
        </Style>
        <Style Name="Grid">
            <Line LineColor="#Border" LineWidth="1"/>
        </Style>
        <Style Name="Temperature">
            <Line LineColor="#Sun" LineWidth="3"/>
        </Style>

        <Panel VirtualWidth="900" VirtualHeight="600" BackgroundColor="#Background">
            <Include>components/header.xml</Include>
            <Include>components/climate-trend.xml</Include>

            <!-- The same component is parameterized before each inclusion. -->
            <Constant Name="MetricX">610</Constant>
            <Constant Name="MetricY">350</Constant>
            <Constant Name="MetricName">AIR TEMP</Constant>
            <Constant Name="MetricValue">23.8 C</Constant>
            <Constant Name="MetricDetail">target 20-25 C</Constant>
            <Constant Name="MetricColor">#Sun</Constant>
            <Constant Name="MetricLevel">162</Constant>
            <Include>components/metric.xml</Include>

            <Constant Name="MetricY">215</Constant>
            <Constant Name="MetricName">HUMIDITY</Constant>
            <Constant Name="MetricValue">68 %</Constant>
            <Constant Name="MetricDetail">preferred 60-75 %</Constant>
            <Constant Name="MetricColor">#Water</Constant>
            <Constant Name="MetricLevel">146</Constant>
            <Include>components/metric.xml</Include>

            <Constant Name="MetricY">80</Constant>
            <Constant Name="MetricName">SOIL MOISTURE</Constant>
            <Constant Name="MetricValue">42 %</Constant>
            <Constant Name="MetricDetail">irrigate below 35 %</Constant>
            <Constant Name="MetricColor">#Leaf</Constant>
            <Constant Name="MetricLevel">90</Constant>
            <Include>components/metric.xml</Include>
        </Panel>
    </Window>
</DCAPP>
