<DCAPP>
    <!-- Variables to receive from Trick (metric, fast update) -->
    <Variable Type="#_variable_double_" InitialValue="0.0">posX</Variable>
    <Variable Type="#_variable_double_" InitialValue="0.0">posY</Variable>
    <Variable Type="#_variable_double_" InitialValue="0.0">velX</Variable>
    <Variable Type="#_variable_double_" InitialValue="0.0">velY</Variable>
    <Variable Type="#_variable_double_" InitialValue="0.0">simTime</Variable>
    <Variable Type="#_variable_integer_" InitialValue="0">impact</Variable>

    <!-- Variables in feet (slower update to test DataRate) -->
    <Variable Type="#_variable_double_" InitialValue="0.0">posX_ft</Variable>
    <Variable Type="#_variable_double_" InitialValue="0.0">posY_ft</Variable>
    <Variable Type="#_variable_double_" InitialValue="0.0">velX_fps</Variable>
    <Variable Type="#_variable_double_" InitialValue="0.0">velY_fps</Variable>

    <!-- Fast connection (DataRate=0.1 = 10Hz) - metric units -->
    <TrickIO Host="localhost" Port="7000" DataRate="0.1">
        <TrickFrom>
            <TrickVariable Name="dyn.cannon.pos[0]">posX</TrickVariable>
            <TrickVariable Name="dyn.cannon.pos[1]">posY</TrickVariable>
            <TrickVariable Name="dyn.cannon.vel[0]">velX</TrickVariable>
            <TrickVariable Name="dyn.cannon.vel[1]">velY</TrickVariable>
            <TrickVariable Name="dyn.cannon.time">simTime</TrickVariable>
            <TrickVariable Name="dyn.cannon.impact">impact</TrickVariable>
        </TrickFrom>
    </TrickIO>

    <!-- Slow connection (DataRate=1.0 = 1Hz) - imperial units to test Units attribute -->
    <TrickIO Host="localhost" Port="7000" DataRate="1.0">
        <TrickFrom>
            <TrickVariable Name="dyn.cannon.pos[0]" Units="ft">posX_ft</TrickVariable>
            <TrickVariable Name="dyn.cannon.pos[1]" Units="ft">posY_ft</TrickVariable>
            <TrickVariable Name="dyn.cannon.vel[0]" Units="ft/s">velX_fps</TrickVariable>
            <TrickVariable Name="dyn.cannon.vel[1]" Units="ft/s">velY_fps</TrickVariable>
        </TrickFrom>
    </TrickIO>

    <Style Name="ReadoutPanel">
        <Container Y="10" Height="80"/>
        <Rectangle Height="80" FillColor="0.1 0.1 0.2 0.9"
            LineColor="0.3 0.3 0.4" LineWidth="1"/>
    </Style>
    <Style Name="ReadoutLabel">
        <Text X="10" Y="60" Size="12" FillColor="0.6 0.6 0.7"/>
    </Style>
    <Style Name="ReadoutValue">
        <Text X="10" Size="14"/>
    </Style>
    <Style Name="CenteredValue">
        <Text ParentAlignX="#_align_center_" ParentAlignY="#_align_middle_"
            LocalAlignX="#_align_center_" LocalAlignY="#_align_middle_"/>
    </Style>

    <Window Title="Cannonball Trajectory - Trick" Width="900" Height="700" VirtualWidth="900" VirtualHeight="700">

        <Rectangle Width="900" Height="700" FillColor="0.05 0.05 0.15"/>

        <Text ParentAlignX="#_align_center_" Y="670" LocalAlignX="#_align_center_" Size="28" FillColor="0.9 0.9 1">Cannonball Trajectory</Text>
        <Text ParentAlignX="#_align_center_" Y="640" LocalAlignX="#_align_center_" Size="14" FillColor="0.5 0.5 0.6">Trick Variable Server</Text>

        <!-- Trajectory visualization area - virtual coords in meters -->
        <!-- Ball travels 221m X, 32m max Y. Container 800x450 = 1.78:1 ratio -->
        <!-- Using 240x135 virtual keeps circles circular (same 1.78:1 ratio) -->
        <Container X="50" Y="100" Width="800" Height="450" VirtualWidth="240" VirtualHeight="135">
            <Rectangle Width="240" Height="135" FillColor="0.1 0.15 0.3"/>

            <Rectangle Width="240" Height="2" FillColor="0.3 0.5 0.3"/>

            <!-- Cannon at origin (bottom-left) -->
            <Polygon FillColor="0.4 0.3 0.2" LineColor="0.2 0.15 0.1" LineWidth="1">
                <Vertex X="0" Y="0"/>
                <Vertex X="12" Y="6"/>
                <Vertex X="12" Y="10"/>
                <Vertex X="0" Y="5"/>
            </Polygon>

            <!-- Cannonball - position driven by simulation -->
            <Ellipse X="@posX" Y="@posY" Radius="4" LocalAlignX="#_align_left_" LocalAlignY="#_align_bottom_" FillColor="0.3 0.3 0.3" LineColor="0.6 0.6 0.6" LineWidth="1"/>
        </Container>

        <!-- Data Panel - Metric (10Hz update) -->
        <Container Style="ReadoutPanel" X="50" Width="270">
            <Rectangle Style="ReadoutPanel" Width="270"/>
            <Text Style="ReadoutLabel">Metric (10Hz)</Text>
            <Text Style="ReadoutValue" Y="40" FillColor="0.4 0.9 0.4">X: @posX(%.1f) m   Y: @posY(%.1f) m</Text>
            <Text Style="ReadoutValue" Y="20" FillColor="0.4 0.7 0.9">Vx: @velX(%.1f) m/s   Vy: @velY(%.1f) m/s</Text>
        </Container>

        <!-- Data Panel - Imperial (1Hz update to test DataRate) -->
        <Container Style="ReadoutPanel" X="330" Width="270">
            <Rectangle Style="ReadoutPanel" Width="270" FillColor="0.15 0.1 0.1 0.9" LineColor="0.4 0.3 0.3"/>
            <Text Style="ReadoutLabel" FillColor="0.7 0.6 0.6">Imperial (1Hz - slower)</Text>
            <Text Style="ReadoutValue" Y="40" FillColor="0.9 0.7 0.4">X: @posX_ft(%.1f) ft   Y: @posY_ft(%.1f) ft</Text>
            <Text Style="ReadoutValue" Y="20" FillColor="0.9 0.5 0.4">Vx: @velX_fps(%.1f) ft/s   Vy: @velY_fps(%.1f) ft/s</Text>
        </Container>

        <Container Style="ReadoutPanel" X="610" Width="130">
            <Rectangle Style="ReadoutPanel" Width="130"/>
            <Text Style="ReadoutLabel">Sim Time</Text>
            <Text Style="CenteredValue" Size="20" FillColor="1 1 1">@simTime(%.2f) s</Text>
        </Container>

        <Container Style="ReadoutPanel" X="750" Width="100">
            <Rectangle Style="ReadoutPanel" Width="100"/>
            <Text Style="ReadoutLabel">Status</Text>
            <If Value="@impact" Value2="1" Operator="#_if_eq_">
                <True>
                    <Text Style="CenteredValue" Size="16" FillColor="1 0.3 0.3">IMPACT!</Text>
                </True>
                <False>
                    <Text Style="CenteredValue" Size="16" FillColor="0.3 1 0.3">In Flight</Text>
                </False>
            </If>
        </Container>

        <!-- Instructions - centered at bottom -->
        <Text ParentAlignX="#_align_center_" Y="5" LocalAlignX="#_align_center_" Size="10" FillColor="0.4 0.4 0.5">Start Trick sim first: cd sim &amp;&amp; ./S_main_*.exe RUN_test/input.py</Text>

    </Window>
</DCAPP>
