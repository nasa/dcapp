<?xml version="1.0"?>
<DCAPP>
    <Constant Name="Background">0.15 0.15 0.2</Constant>
    <Constant Name="Heading">0.8 0.8 0.2</Constant>
    <Constant Name="Muted">0.65 0.65 0.7</Constant>

    <Default>
        <Text Size="14" FillColor="1 1 1"/>
    </Default>
    <Style Name="SectionTitle">
        <Text Size="18" FillColor="#Heading"/>
    </Style>
    <Style Name="Note">
        <Text Size="13" FillColor="#Muted"/>
    </Style>

    <Window Title="Stencil masks" Width="1200" Height="600">
        <Panel VirtualWidth="1500" VirtualHeight="750" BackgroundColor="#Background">
            <Text X="20" Y="710" Size="24">Stencils</Text>
            <Text X="20" Y="676" Style="Note">Add mask geometry, remove cutouts, then draw through the result.</Text>

            <Text X="20" Y="615" Style="SectionTitle">1. Text mask</Text>
            <Stencil>
                <StencilAdd>
                    <Text X="20" Y="485" Size="80" FillColor="#_stencil_color_">MASKED</Text>
                </StencilAdd>
                <StencilDraw>
                    <Rectangle X="0" Y="560" Width="410" Height="30" FillColor="1 0 0"/>
                    <Rectangle X="0" Y="530" Width="410" Height="30" FillColor="1 0.5 0"/>
                    <Rectangle X="0" Y="500" Width="410" Height="30" FillColor="1 1 0"/>
                    <Rectangle X="0" Y="470" Width="410" Height="30" FillColor="0 1 0"/>
                    <Rectangle X="0" Y="440" Width="410" Height="30" FillColor="0 0 1"/>
                </StencilDraw>
            </Stencil>
            <Text X="20" Y="385" Style="Note">StencilAdd: text / StencilDraw: color bands</Text>

            <Text X="450" Y="615" Style="SectionTitle">2. Add + remove</Text>
            <Stencil>
                <StencilAdd>
                    <Ellipse X="600" Y="485" Radius="100" FillColor="#_stencil_color_"/>
                </StencilAdd>
                <!-- Removing the inner ellipse leaves a ring. -->
                <StencilRemove>
                    <Ellipse X="600" Y="485" Radius="50" FillColor="#_stencil_color_"/>
                </StencilRemove>
                <StencilDraw>
                    <Rectangle X="450" Y="585" Width="300" Height="40" FillColor="1 0.2 0.2"/>
                    <Rectangle X="450" Y="545" Width="300" Height="40" FillColor="0.2 1 0.2"/>
                    <Rectangle X="450" Y="505" Width="300" Height="40" FillColor="0.2 0.2 1"/>
                    <Rectangle X="450" Y="465" Width="300" Height="40" FillColor="1 1 0.2"/>
                    <Rectangle X="450" Y="425" Width="300" Height="40" FillColor="1 0.2 1"/>
                    <Rectangle X="450" Y="385" Width="300" Height="40" FillColor="0.2 1 1"/>
                </StencilDraw>
            </Stencil>
            <Text X="450" Y="350" Style="Note">Outer ellipse - inner ellipse = ring</Text>

            <Text X="780" Y="615" Style="SectionTitle">3. Cumulative operations</Text>
            <Stencil>
                <StencilAdd>
                    <Ellipse X="880" Y="495" Radius="60" FillColor="#_stencil_color_"/>
                    <Ellipse X="960" Y="495" Radius="60" FillColor="#_stencil_color_"/>
                    <Ellipse X="920" Y="435" Radius="60" FillColor="#_stencil_color_"/>
                </StencilAdd>
                <StencilRemove>
                    <Ellipse X="920" Y="475" Radius="25" FillColor="#_stencil_color_"/>
                </StencilRemove>
                <StencilAdd>
                    <Ellipse X="920" Y="475" Radius="10" FillColor="#_stencil_color_"/>
                </StencilAdd>
                <StencilDraw>
                    <Rectangle X="780" Y="555" Width="280" Height="40" FillColor="1 0 0"/>
                    <Rectangle X="780" Y="515" Width="280" Height="40" FillColor="0 1 0"/>
                    <Rectangle X="780" Y="475" Width="280" Height="40" FillColor="0 0 1"/>
                    <Rectangle X="780" Y="435" Width="280" Height="40" FillColor="1 1 0"/>
                    <Rectangle X="780" Y="395" Width="280" Height="40" FillColor="1 0 1"/>
                    <Rectangle X="780" Y="355" Width="280" Height="40" FillColor="0 1 1"/>
                </StencilDraw>
            </Stencil>
            <Text X="780" Y="320" Style="Note">Add, remove, then add back</Text>

            <Text X="1100" Y="615" Style="SectionTitle">4. Image alpha mask</Text>
            <Stencil>
                <StencilAdd>
                    <Image X="1100" Y="415" Width="360" Height="101"
                        File="../../assets/nasa-worm.png"/>
                </StencilAdd>
                <StencilDraw>
                    <Rectangle X="1080" Y="520" Width="400" Height="20" FillColor="1 0 0"/>
                    <Rectangle X="1080" Y="500" Width="400" Height="20" FillColor="1 0.5 0"/>
                    <Rectangle X="1080" Y="480" Width="400" Height="20" FillColor="1 1 0"/>
                    <Rectangle X="1080" Y="460" Width="400" Height="20" FillColor="0 1 0"/>
                    <Rectangle X="1080" Y="440" Width="400" Height="20" FillColor="0 0.5 1"/>
                    <Rectangle X="1080" Y="420" Width="400" Height="20" FillColor="0.5 0 1"/>
                </StencilDraw>
            </Stencil>
            <Text X="1100" Y="385" Style="Note">Transparent pixels stay outside the mask</Text>

            <!-- Drawing after a Stencil block is not clipped. -->
            <Text X="20" Y="250" Style="SectionTitle">Outside the stencil</Text>
            <Rectangle X="20" Y="175" Width="1460" Height="50" FillColor="0.2 0.4 0.6"/>
            <Text X="750" Y="200" LocalAlignX="#_align_center_" LocalAlignY="#_align_middle_">
                Normal drawing is unaffected
            </Text>
            <Text X="20" Y="135" Style="Note">Each Stencil owns an independent mask.</Text>
        </Panel>
    </Window>
</DCAPP>
