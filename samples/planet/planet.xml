<?xml version="1.0"?>
<DCAPP>
    <!-- Five-map XML geodetic view (left) vs five-map logic geodetic view (right) -->

    <!-- Slider raw values (all 0-100 range, mapped to actual values via Set) -->
    <Variable Type="#_variable_double_" InitialValue="17.433">SliderLat</Variable>
    <Variable Type="#_variable_double_" InitialValue="95.908">SliderLon</Variable>
    <Variable Type="#_variable_double_" InitialValue="40">SliderEle</Variable>
    <Variable Type="#_variable_double_" InitialValue="0">SliderHdg</Variable>
    <Variable Type="#_variable_double_" InitialValue="30">SliderTau</Variable>
    <Variable Type="#_variable_double_" InitialValue="0">SliderLightY</Variable>

    <Variable Type="#_variable_double_" InitialValue="-58.62">Latitude</Variable>
    <Variable Type="#_variable_double_" InitialValue="345.27">Longitude</Variable>
    <Variable Type="#_variable_double_" InitialValue="2000000">Elevation</Variable>
    <Variable Type="#_variable_double_" InitialValue="0">Heading</Variable>
    <Variable Type="#_variable_double_" InitialValue="0.3">Tau</Variable>
    <Variable Type="#_variable_double_" InitialValue="-1">LightY</Variable>
    <Variable Type="#_variable_double_" InitialValue="-65">OrbitLat</Variable>
    <Variable Type="#_variable_double_" InitialValue="315">OrbitLon</Variable>
    <Variable Type="#_variable_double_" InitialValue="0">LocalRotation</Variable>

    <Variable Type="#_variable_string_">LogicReadout</Variable>

    <Variable Type="#_variable_integer_">SliderLatSelected</Variable>
    <Variable Type="#_variable_integer_">SliderLonSelected</Variable>
    <Variable Type="#_variable_integer_">SliderEleSelected</Variable>
    <Variable Type="#_variable_integer_">SliderHdgSelected</Variable>
    <Variable Type="#_variable_integer_">SliderTauSelected</Variable>
    <Variable Type="#_variable_integer_">SliderLightYSelected</Variable>

    <!-- Independent shader indices: 1=elevation, 2=slope -->
    <Variable Type="#_variable_integer_" InitialValue="1">LeftShader</Variable>
    <Variable Type="#_variable_integer_" InitialValue="2">RightShader</Variable>

    <Variable Type="#_variable_integer_" InitialValue="0">UseOrtho</Variable>

    <Variable Type="#_variable_integer_" InitialValue="0">TextureRefresh</Variable>
    <Variable Type="#_variable_double_" InitialValue="2000">TexMpp</Variable>
    <Variable Type="#_variable_integer_" InitialValue="1">HazardMap0Enabled</Variable>
    <Variable Type="#_variable_integer_" InitialValue="1">HazardMap1Enabled</Variable>
    <Variable Type="#_variable_integer_" InitialValue="1">HazardMap2Enabled</Variable>
    <Variable Type="#_variable_integer_" InitialValue="1">HazardMap3Enabled</Variable>
    <Variable Type="#_variable_integer_" InitialValue="1">HazardMap4Enabled</Variable>

    <Logic File="logic/logic.so"/>

    <Style Name="HazardTexture">
        <PlanetTexture MetersPerPixel="@TexMpp" Latitude="-58.62" Longitude="345.27"
            FireRefresh="@TextureRefresh"/>
    </Style>

    <!-- Top-level planet definition used by the XML view. -->
    <Planet Name="Moon" CRS="#_planet_crs_geodetic_" MeshCacheSize="128" LightDirectionX="-1" LightDirectionY="@LightY" LightDirectionZ="-1">
        <PlanetData File="$DCAPP_HOME/data/LDEM_45S_400M.planet.json"/>
        <!-- Hazard-map slots are assigned by declaration order. -->
        <PlanetTexture Style="HazardTexture" File="$DCAPP_HOME/assets/circle.png" Enabled="@HazardMap0Enabled"/>
        <PlanetTexture Style="HazardTexture" File="$DCAPP_HOME/assets/square.png" Enabled="@HazardMap1Enabled"/>
        <PlanetTexture Style="HazardTexture" File="$DCAPP_HOME/assets/triangle.png" Enabled="@HazardMap2Enabled"/>
        <PlanetTexture Style="HazardTexture" File="$DCAPP_HOME/assets/ring.png" Enabled="@HazardMap3Enabled"/>
        <PlanetTexture Style="HazardTexture" File="$DCAPP_HOME/assets/cross.png" Enabled="@HazardMap4Enabled"/>
        <PlanetShader Index="1" FragmentShader="shaders/planet_elevation.frag"/>
        <PlanetShader Index="2" FragmentShader="shaders/planet_slope.frag"/>
    </Planet>

    <Default>
        <Text Size="14" FillColor="#_color_white_"/>
        <Button LocalAlignX="#_align_center_" LocalAlignY="#_align_middle_"/>
    </Default>

    <Style Name="ToggleLabel">
        <Text ParentAlignX="#_align_center_" ParentAlignY="#_align_middle_"
            LocalAlignX="#_align_center_" LocalAlignY="#_align_middle_" Size="11"/>
    </Style>
    <Style Name="ToggleOff">
        <Rectangle FillColor="0.15 0.15 0.15" LineColor="0.35 0.35 0.35" LineWidth="1"/>
        <Text ParentAlignX="#_align_center_" ParentAlignY="#_align_middle_"
            LocalAlignX="#_align_center_" LocalAlignY="#_align_middle_"
            Size="11" FillColor="0.6 0.6 0.6"/>
    </Style>
    <Style Name="HeaderToggle">
        <Button Type="#_button_toggle_" Y="806" Width="90" Height="22" On="1" Off="0"/>
    </Style>
    <Style Name="HeaderToggleOn">
        <Rectangle FillColor="0.2 0.5 0.2" LineColor="0.3 0.8 0.3" LineWidth="2"/>
    </Style>
    <Style Name="ShaderToggle">
        <Button Type="#_button_toggle_" Y="806" Width="150" Height="22"/>
    </Style>
    <Style Name="ElevationIndicator">
        <Rectangle FillColor="0.24 0.34 0.14" LineColor="0.70 0.82 0.28" LineWidth="2"/>
    </Style>
    <Style Name="SlopeIndicator">
        <Rectangle FillColor="0.45 0.18 0.16" LineColor="0.90 0.30 0.24" LineWidth="2"/>
    </Style>
    <Style Name="HazardToggle">
        <Button Type="#_button_toggle_" Y="780" Width="110" Height="22" On="1" Off="0"/>
    </Style>
    <Style Name="SliderLabel">
        <Text X="15" LocalAlignX="#_align_left_"/>
    </Style>
    <Style Name="SliderValue">
        <Text X="195" LocalAlignX="#_align_right_"/>
    </Style>
    <Style Name="Slider">
        <Container X="210" Width="775" Height="20" VirtualWidth="100"/>
        <Rectangle FillColor="#_color_dark_gray_" LineColor="#_color_gray_" LineWidth="1"/>
        <Button Type="#_button_momentary_" Y="10" Width="8" Height="26"/>
    </Style>

    <Window X="0" Y="20" Width="1000" Height="840" UpdateRate="60">
        <Panel VirtualWidth="1000" VirtualHeight="840" BackgroundColor="#_color_black_">

            <!-- Compute values from sliders (all sliders are 0-100) -->
            <Set Variable="Latitude">@SliderLat</Set>
            <Set Variable="Latitude" Operator="#_set_multiply_">1.8</Set>
            <Set Variable="Latitude" Operator="#_set_subtract_">90</Set>
            <Set Variable="Longitude">@SliderLon</Set>
            <Set Variable="Longitude" Operator="#_set_multiply_">3.6</Set>
            <Set Variable="Elevation">@SliderEle</Set>
            <Set Variable="Elevation" Operator="#_set_multiply_">50000</Set>
            <Set Variable="Heading">@SliderHdg</Set>
            <Set Variable="Heading" Operator="#_set_multiply_">3.6</Set>
            <Set Variable="Tau">@SliderTau</Set>
            <Set Variable="Tau" Operator="#_set_multiply_">0.01</Set>
            <Set Variable="LightY">@SliderLightY</Set>
            <Set Variable="LightY" Operator="#_set_multiply_">0.02</Set>
            <Set Variable="LightY" Operator="#_set_subtract_">1</Set>

            <Button Style="HeaderToggle" X="60" Variable="TextureRefresh">
                <ButtonIndicatorOn>
                    <Rectangle Style="HeaderToggleOn"/>
                    <Text Style="ToggleLabel">Refresh</Text>
                </ButtonIndicatorOn>
                <ButtonIndicatorOff>
                    <Rectangle Style="ToggleOff"/>
                    <Text Style="ToggleOff">Refresh</Text>
                </ButtonIndicatorOff>
            </Button>

            <Button Style="HeaderToggle" X="170" Variable="UseOrtho">
                <ButtonIndicatorOn>
                    <Rectangle Style="HeaderToggleOn"/>
                    <Text Style="ToggleLabel">Ortho</Text>
                </ButtonIndicatorOn>
                <ButtonIndicatorOff>
                    <Rectangle Style="ToggleOff"/>
                    <Text Style="ToggleOff">Ortho</Text>
                </ButtonIndicatorOff>
            </Button>

            <Text X="290" Y="806" LocalAlignX="#_align_right_" LocalAlignY="#_align_middle_"
                Size="13">Shaders:</Text>

            <Button Style="ShaderToggle" X="410" Variable="LeftShader" On="2" Off="1" IndicatorOn="2">
                <ButtonIndicatorOn>
                    <Rectangle Style="SlopeIndicator"/>
                    <Text Style="ToggleLabel">Left: Slope</Text>
                </ButtonIndicatorOn>
                <ButtonIndicatorOff>
                    <Rectangle Style="ElevationIndicator"/>
                    <Text Style="ToggleLabel">Left: Elevation</Text>
                </ButtonIndicatorOff>
            </Button>

            <Button Style="ShaderToggle" X="590" Variable="RightShader" On="1" Off="2" IndicatorOn="1">
                <ButtonIndicatorOn>
                    <Rectangle Style="ElevationIndicator"/>
                    <Text Style="ToggleLabel">Right: Elevation</Text>
                </ButtonIndicatorOn>
                <ButtonIndicatorOff>
                    <Rectangle Style="SlopeIndicator"/>
                    <Text Style="ToggleLabel">Right: Slope</Text>
                </ButtonIndicatorOff>
            </Button>

            <Text X="95" Y="780" LocalAlignX="#_align_right_" LocalAlignY="#_align_middle_"
                Size="13">Hazards:</Text>

            <Button Style="HazardToggle" X="170" Variable="HazardMap0Enabled">
                <ButtonIndicatorOn>
                    <Rectangle FillColor="0.55 0.12 0.12" LineColor="1.0 0.35 0.30" LineWidth="2"/>
                    <Text Style="ToggleLabel">Circle On</Text>
                </ButtonIndicatorOn>
                <ButtonIndicatorOff>
                    <Rectangle Style="ToggleOff"/>
                    <Text Style="ToggleOff">Circle Off</Text>
                </ButtonIndicatorOff>
            </Button>

            <Button Style="HazardToggle" X="290" Variable="HazardMap1Enabled">
                <ButtonIndicatorOn>
                    <Rectangle FillColor="0.08 0.42 0.48" LineColor="0.20 0.90 1.0" LineWidth="2"/>
                    <Text Style="ToggleLabel">Square On</Text>
                </ButtonIndicatorOn>
                <ButtonIndicatorOff>
                    <Rectangle Style="ToggleOff"/>
                    <Text Style="ToggleOff">Square Off</Text>
                </ButtonIndicatorOff>
            </Button>

            <Button Style="HazardToggle" X="410" Variable="HazardMap2Enabled">
                <ButtonIndicatorOn>
                    <Rectangle FillColor="0.52 0.42 0.08" LineColor="1.0 0.82 0.20" LineWidth="2"/>
                    <Text Style="ToggleLabel">Triangle On</Text>
                </ButtonIndicatorOn>
                <ButtonIndicatorOff>
                    <Rectangle Style="ToggleOff"/>
                    <Text Style="ToggleOff">Triangle Off</Text>
                </ButtonIndicatorOff>
            </Button>

            <Button Style="HazardToggle" X="530" Variable="HazardMap3Enabled">
                <ButtonIndicatorOn>
                    <Rectangle FillColor="0.12 0.45 0.18" LineColor="0.30 1.0 0.45" LineWidth="2"/>
                    <Text Style="ToggleLabel">Ring On</Text>
                </ButtonIndicatorOn>
                <ButtonIndicatorOff>
                    <Rectangle Style="ToggleOff"/>
                    <Text Style="ToggleOff">Ring Off</Text>
                </ButtonIndicatorOff>
            </Button>

            <Button Style="HazardToggle" X="650" Variable="HazardMap4Enabled">
                <ButtonIndicatorOn>
                    <Rectangle FillColor="0.50 0.12 0.50" LineColor="1.0 0.32 1.0" LineWidth="2"/>
                    <Text Style="ToggleLabel">Cross On</Text>
                </ButtonIndicatorOn>
                <ButtonIndicatorOff>
                    <Rectangle Style="ToggleOff"/>
                    <Text Style="ToggleOff">Cross Off</Text>
                </ButtonIndicatorOff>
            </Button>

            <Text X="240" Y="762" LocalAlignX="#_align_center_" Size="14" FillColor="#_color_yellow_">XML: PlanetContainer</Text>
            <PlanetView Planet="Moon" CRS="#_planet_crs_geodetic_" AttitudeFrame="#_planet_attitude_frame_local_ned_" X="15" Y="300" Width="450" Height="450"
                CameraLatitude="@Latitude" CameraLongitude="@Longitude" CameraElevation="@Elevation"
                CameraYaw="@Heading"
                CameraOrthographic="@UseOrtho" ShaderIndex="@LeftShader"
                Tau="@Tau">
                <PlanetBreadcrumbs CRS="#_planet_crs_geodetic_" Latitude="@OrbitLat" Longitude="@OrbitLon"
                    HeightAboveTerrain="50000" PointSpacing="25000" MaxPoints="512"
                    LineColor="0.1 0.9 1.0 0.85" LineWidth="3.5" LinePattern="0xF0"/>
                <PlanetSphere CRS="#_planet_crs_geodetic_" Latitude="@OrbitLat" Longitude="@OrbitLon"
                    HeightAboveTerrain="50000" Radius="18000" FillColor="0.1 0.9 1.0 1.0"/>
                <!-- The small XY shape is scaled, rotated, and moved as one unit. -->
                <PlanetContainer Latitude="@OrbitLat" Longitude="@OrbitLon"
                    HeightAboveTerrain="60000" Rotation="@LocalRotation" Scale="2000">
                    <PlanetPolygon LineColor="0.1 0.9 1.0 1.0" LineWidth="2.1" LinePattern="0xAA"
                        FillColor="0.1 0.65 1.0 0.22">
                        <Vertex X="-40" Y="-30"/>
                        <Vertex X="40" Y="-30"/>
                        <Vertex X="40" Y="10"/>
                        <Vertex X="0" Y="50"/>
                        <Vertex X="-40" Y="10"/>
                    </PlanetPolygon>
                    <PlanetText X="0" Y="0" Size="12"
                        FillColor="0.1 0.9 1.0 1.0">LOCAL</PlanetText>
                </PlanetContainer>
                <PlanetGeoJSON File="assets/geojson_test.geojson" HeightAboveTerrain="1500"
                    LineColor="0.25 0.70 1.0 0.90" LineWidth="2.2" FillColor="0.25 0.70 1.0 0.10"/>
                <!-- Image top follows planet-local yaw; Rotation is a view-space offset. -->
                <PlanetImage File="$DCAPP_HOME/assets/triangle.png"
                    Latitude="-58.62" Longitude="345.27" HeightAboveTerrain="120000"
                    Width="120000" Height="120000" Yaw="@LocalRotation" Rotation="15"/>
                <PlanetEllipse Latitude="-55.0" Longitude="335.0" HeightAboveTerrain="1500"
                    RadiusX="80000" RadiusY="40000" Rotation="25" Segments="64"
                    LineColor="1.0 0.35 0.80 0.90" LineWidth="2.5" FillColor="1.0 0.20 0.70 0.12"/>
                <PlanetSphere Latitude="-66.82" Longitude="-68.90" Radius="150500" HeightAboveTerrain="1000" FillColor="1.0 0.78 0.18 0.18"/>
                <PlanetSphere Latitude="-58.62" Longitude="-14.73" Radius="115385" HeightAboveTerrain="1000" FillColor="0.0 0.95 1.0 0.20"/>
                <PlanetSphere Latitude="-50.00" Longitude="-6.20" Radius="97000" HeightAboveTerrain="1000" FillColor="0.45 1.0 0.25 0.18"/>
                <PlanetSphere Latitude="-51.72" Longitude="-39.78" Radius="89500" HeightAboveTerrain="1000" FillColor="1.0 0.42 0.12 0.18"/>
                <PlanetSphere Latitude="-65.11" Longitude="-88.49" Radius="81500" HeightAboveTerrain="1000" FillColor="0.35 0.55 1.0 0.19"/>
                <PlanetSphere Latitude="-89.67" Longitude="129.78" Radius="10460" HeightAboveTerrain="1000" FillColor="1.0 0.25 0.95 0.23"/>
                <PlanetText CRS="#_planet_crs_geodetic_" Latitude="-66.82" Longitude="-68.90" HeightAboveTerrain="85000" Size="30000"
                    FillColor="1.0 0.92 0.62 1.0">Bailly 301 km</PlanetText>
                <PlanetText CRS="#_planet_crs_geodetic_" Latitude="-58.62" Longitude="-14.73" HeightAboveTerrain="85000" Size="30000"
                    FillColor="1.0 0.92 0.62 1.0">Clavius 231 km</PlanetText>
                <PlanetText CRS="#_planet_crs_geodetic_" Latitude="-50.00" Longitude="-6.20" HeightAboveTerrain="85000" Size="28000"
                    FillColor="1.0 0.92 0.62 1.0">Maginus 194 km</PlanetText>
                <PlanetText CRS="#_planet_crs_geodetic_" Latitude="-51.72" Longitude="-39.78" HeightAboveTerrain="85000" Size="28000"
                    FillColor="1.0 0.92 0.62 1.0">Schiller 179 km</PlanetText>
                <PlanetText CRS="#_planet_crs_geodetic_" Latitude="-65.11" Longitude="-88.49" HeightAboveTerrain="85000" Size="28000"
                    FillColor="1.0 0.92 0.62 1.0">Hausen 163 km</PlanetText>
                <PlanetText Latitude="-89.67" Longitude="129.78" HeightAboveTerrain="50000" Size="30000" FillColor="1.0 0.4 1.0 1.0">Shackleton 21 km</PlanetText>
            </PlanetView>

            <Text X="760" Y="762" LocalAlignX="#_align_center_" Size="14" FillColor="#_color_sky_blue_">Logic: planet container</Text>
            <Container X="535" Y="300" Width="450" Height="450" VirtualWidth="450" VirtualHeight="450">
                <DrawFunction Name="draw_logic_planet_view"/>
            </Container>

            <!-- Latitude: 0-100 → -90 to +90 deg -->
            <Text Style="SliderLabel" Y="270">Lat:</Text>
            <Text Style="SliderValue" Y="270">@Latitude(%.1f) deg</Text>
            <Container Style="Slider" Y="260">
                <Rectangle Style="Slider"/>
                <If Value1="@SliderLatSelected" Operator="#_if_eq_" Value2="1">
                    <MouseMotion VariableX="SliderLat"/>
                </If>
                <Set Variable="SliderLat" Operator="#_set_max_">0</Set>
                <Set Variable="SliderLat" Operator="#_set_min_">100</Set>
                <Button Style="Slider" X="@SliderLat" Variable="SliderLatSelected">
                    <ButtonIndicatorOn><Rectangle FillColor="#_color_lime_"/></ButtonIndicatorOn>
                    <ButtonIndicatorOff><Rectangle FillColor="#_color_gray_"/></ButtonIndicatorOff>
                </Button>
            </Container>

            <!-- Longitude: 0-100 → 0 to 360 deg -->
            <Text Style="SliderLabel" Y="220">Lon:</Text>
            <Text Style="SliderValue" Y="220">@Longitude(%.1f) deg</Text>
            <Container Style="Slider" Y="210">
                <Rectangle Style="Slider"/>
                <If Value1="@SliderLonSelected" Operator="#_if_eq_" Value2="1">
                    <MouseMotion VariableX="SliderLon"/>
                </If>
                <Set Variable="SliderLon" Operator="#_set_max_">0</Set>
                <Set Variable="SliderLon" Operator="#_set_min_">100</Set>
                <Button Style="Slider" X="@SliderLon" Variable="SliderLonSelected">
                    <ButtonIndicatorOn><Rectangle FillColor="#_color_lime_"/></ButtonIndicatorOn>
                    <ButtonIndicatorOff><Rectangle FillColor="#_color_gray_"/></ButtonIndicatorOff>
                </Button>
            </Container>

            <!-- Elevation: 1-100 → 50,000 to 5,000,000 m -->
            <Text Style="SliderLabel" Y="170">Ele:</Text>
            <Text Style="SliderValue" Y="170">@Elevation(%.0f) m</Text>
            <Container Style="Slider" Y="160">
                <Rectangle Style="Slider"/>
                <If Value1="@SliderEleSelected" Operator="#_if_eq_" Value2="1">
                    <MouseMotion VariableX="SliderEle"/>
                </If>
                <Set Variable="SliderEle" Operator="#_set_max_">1</Set>
                <Set Variable="SliderEle" Operator="#_set_min_">100</Set>
                <Button Style="Slider" X="@SliderEle" Variable="SliderEleSelected">
                    <ButtonIndicatorOn><Rectangle FillColor="#_color_lime_"/></ButtonIndicatorOn>
                    <ButtonIndicatorOff><Rectangle FillColor="#_color_gray_"/></ButtonIndicatorOff>
                </Button>
            </Container>

            <!-- Heading: 0-100 → 0 to 360 deg -->
            <Text Style="SliderLabel" Y="120">Hdg:</Text>
            <Text Style="SliderValue" Y="120">@Heading(%.0f) deg</Text>
            <Container Style="Slider" Y="110">
                <Rectangle Style="Slider"/>
                <If Value1="@SliderHdgSelected" Operator="#_if_eq_" Value2="1">
                    <MouseMotion VariableX="SliderHdg"/>
                </If>
                <Set Variable="SliderHdg" Operator="#_set_max_">0</Set>
                <Set Variable="SliderHdg" Operator="#_set_min_">100</Set>
                <Button Style="Slider" X="@SliderHdg" Variable="SliderHdgSelected">
                    <ButtonIndicatorOn><Rectangle FillColor="#_color_lime_"/></ButtonIndicatorOn>
                    <ButtonIndicatorOff><Rectangle FillColor="#_color_gray_"/></ButtonIndicatorOff>
                </Button>
            </Container>

            <!-- Tau: 1-100 → 0.01 to 1.00 -->
            <Text Style="SliderLabel" Y="70">Tau:</Text>
            <Text Style="SliderValue" Y="70">@Tau(%.2f)</Text>
            <Container Style="Slider" Y="60">
                <Rectangle Style="Slider"/>
                <If Value1="@SliderTauSelected" Operator="#_if_eq_" Value2="1">
                    <MouseMotion VariableX="SliderTau"/>
                </If>
                <Set Variable="SliderTau" Operator="#_set_max_">1</Set>
                <Set Variable="SliderTau" Operator="#_set_min_">100</Set>
                <Button Style="Slider" X="@SliderTau" Variable="SliderTauSelected">
                    <ButtonIndicatorOn><Rectangle FillColor="#_color_lime_"/></ButtonIndicatorOn>
                    <ButtonIndicatorOff><Rectangle FillColor="#_color_gray_"/></ButtonIndicatorOff>
                </Button>
            </Container>

            <!-- Light Y: 0-100 → -1.0 to +1.0 -->
            <Text Style="SliderLabel" Y="20">Light Y:</Text>
            <Text Style="SliderValue" Y="20">@LightY(%.2f)</Text>
            <Container Style="Slider" Y="10">
                <Rectangle Style="Slider"/>
                <If Value1="@SliderLightYSelected" Operator="#_if_eq_" Value2="1">
                    <MouseMotion VariableX="SliderLightY"/>
                </If>
                <Set Variable="SliderLightY" Operator="#_set_max_">0</Set>
                <Set Variable="SliderLightY" Operator="#_set_min_">100</Set>
                <Button Style="Slider" X="@SliderLightY" Variable="SliderLightYSelected">
                    <ButtonIndicatorOn><Rectangle FillColor="#_color_lime_"/></ButtonIndicatorOn>
                    <ButtonIndicatorOff><Rectangle FillColor="#_color_gray_"/></ButtonIndicatorOff>
                </Button>
            </Container>

            <Text X="15" Y="290" LocalAlignX="#_align_left_" Size="11" FillColor="#_color_sky_blue_">@LogicReadout</Text>

        </Panel>
    </Window>
</DCAPP>
